# Secrets and machine-local paths only. Everything about the LLM/embedding provider
# (AIaaS broker/gateway URLs, scopes, models) lives in backend/shared/config/llm_config.yaml
# instead - see that file to configure it. AIaaS is the only supported provider.

# Path to the local SQLite database (chunks + metadata + sqlite-vec vectors)
RAG_DB_PATH=data/rag.db

# Set to true for detailed per-stage DEBUG logs (chunk counts, scores, timings) tracing
# a request's full path through the system. Leave false for quieter INFO-level logs.
VERBOSE_LOGGING=false
