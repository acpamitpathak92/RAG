# Secrets and environment-specific values only - this file is committed, .env is not.
# Copy this to .env and fill in real values for your environment. Non-sensitive,
# environment-independent settings (per-role temperatures) live in
# backend/shared/config/llm_config.yaml instead. AIaaS is the only supported provider.

# Path to the local SQLite database (chunks + metadata + sqlite-vec vectors)
RAG_DB_PATH=data/rag.db

# Set to true for detailed per-stage DEBUG logs (chunk counts, scores, timings) tracing
# a request's full path through the system. Leave false for quieter INFO-level logs.
VERBOSE_LOGGING=false

# --- AIaaS (internal UBS LLM/embedding gateway) ---

# "devpod": broker-based auth for local/remote dev environments with no browser (uses
#   AIAAS_BROKER_URL).
# "managed_identity": for Azure-hosted compute with an assigned managed identity (uses
#   AIAAS_MANAGED_IDENTITY_CLIENT_ID, or falls back to the AZURE_CLIENT_ID env var).
AIAAS_AUTH_MODE=devpod

AIAAS_TENANT_ID=
AIAAS_BROKER_URL=
AIAAS_MANAGED_IDENTITY_CLIENT_ID=

# OAuth scope(s) requested on every auth call, comma-separated if more than one. Some
# gateway routes (embeddings has been observed to need this) 404 without the right scope
# on the token, even though the same token works fine for chat completions.
AIAAS_SCOPES=

AIAAS_GATEWAY_BASE_URL=
AIAAS_CHAT_MODEL=
AIAAS_EMBEDDING_MODEL=
